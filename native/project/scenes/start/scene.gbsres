                  "id": "d0c6e770-27c3-5cf3-9aa7-288aff087c3c",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "THE REAL PORCH\nLAMP BURNS\nSTEADY. A",
                      "FAMILIAR VOICE\nWELCOMES YOU.",
                      "YOU CHECKED THE\nCLUES, TRUSTED\nYOUR FRIENDS,",
                      "AND BROUGHT THE\nLIGHT HOME.",
                      "MOTH FINDS THE\nWINDOW. TURTLE\nFINDS THE SUN.",
                      "THUNDERBIRD\nSTEALS TOAST."
                    ],
                    "minHeight": 4,
                    "maxHeight": 4,
                    "textHeight": 3,
                    "closeButton": "a"
                  }
                },
                {
                  "id": "09134974-ecf1-50ee-8101-1525a3d859a6",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "POCKETHOLLER:\nAFTER SUNDOWN",
                      "FOR MARTY AND\nROAM. THANK YOU\nFOR PLAYING.",
                      "STORY, NATIVE\nART AND ORIGINAL\nMUSIC:",
                      "POCKETHOLLER\nTEAM.",
                      "CREATED WITH\nOPENAI CODEX.\nENGINE: GB",
                      "STUDIO, CHRIS\nMALTBY AND\nCONTRIBUTORS.",
                      "RUNTIME AND\nTEMPLATE\nNOTICES: SEE THE",
                      "SOURCE CREDITS.",
                      "MORNING AGAIN.\nEVERYONE MADE IT\nHOME."
                    ],
                    "minHeight": 4,
                    "maxHeight": 4,
                    "textHeight": 3,
                    "closeButton": "a"
