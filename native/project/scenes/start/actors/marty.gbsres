      "children": {
        "true": [
          {
            "id": "48250286-3d56-520e-9078-50bf6682385e",
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "MARTY: THERE YOU\nARE. ONE LIGHT\nBACK ON.",
                "MOTH KNOWS THE\nWAY. WE WILL\nHANDLE THE CREEK",
                "TOGETHER NEXT.",
                "THAT WAS A GOOD\nBIT OF NOTICING,\nROAM."
              ],
              "minHeight": 4,
              "maxHeight": 4,
              "textHeight": 3,
              "closeButton": "a"
            }
          }
        ],
        "false": [
          {
            "id": "c66b5215-9db6-502a-992c-f842bbe087c5",
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "MARTY: I WILL\nKEEP THIS PORCH\nSIGNAL LIT.",
                "JUNE HAS THE MAP\nIN THE STORE.\nTAKE A LOOK AT",
                "THE ORCHARD.",
                "COME HOME WHEN\nTHE FIRST LIGHT\nIS ON. I WILL BE",
                "RIGHT HERE."
              ],
              "minHeight": 4,
              "maxHeight": 4,
              "textHeight": 3,
              "closeButton": "a"
            }
          }
        ]
      }
    },
