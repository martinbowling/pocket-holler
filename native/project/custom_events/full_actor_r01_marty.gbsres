                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "MARTY: THE PORCH\nLIGHT IS STEADY.\nFOLLOW THE CREEK",
                      "WHEN YOU ARE\nREADY.",
                      "WE CAN ALWAYS\nREST, SWAP\nCOMPANIONS, AND",
                      "SAVE HERE."
                    ],
                    "minHeight": 4,
                    "maxHeight": 4,
                    "textHeight": 3,
                    "closeButton": "a"
                  }
                }
              ],
              "false": [
                {
                  "id": "8ef0e06e-4f22-509b-8eb8-6a53435d8702",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "MARTY: I WILL\nKEEP THIS PORCH\nSIGNAL LIT.",
                      "ASK JUNE IN THE\nSTORE. THEN\nCHECK THE",
                      "ORCHARD LANTERN."
                    ],
                    "minHeight": 4,
                    "maxHeight": 4,
                    "textHeight": 3,
                    "closeButton": "a"
                  }
                }
              ]
            }
          }
        ]
      }
