                                                            "command": "EVENT_TEXT",
                                                            "args": {
                                                              "text": [
                                                                "THE BELL RINGS\nFOR EVERYONE.\nTHE TOWN ANSWERS",
                                                                "WITH ITS OWN\nLIGHT.",
                                                                "THE BORROWED\nWORDS LOOSEN\nINTO HARMLESS",
                                                                "ECHOES. ONLY\nWIND REMAINS.",
                                                                "ALL THREE\nFRIENDS ARE\nSAFE. DAWN",
                                                                "RETURNS TO\nPOCKETHOLLER.",
                                                                "GO HOME FOR\nBREAKFAST. YOUR\nFINISHED PUZZLES",
                                                                "STAY FINISHED.",
                                                                "THIS DOES NOT\nWRITE A SAVE.\nSAVE AT THE",
                                                                "PORCH AFTER THE\nREUNION."
                                                              ],
