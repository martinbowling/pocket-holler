                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "ROAM: THE PORCH\nLIGHT IS STEADY.\nFOLLOW THE CREEK",
                      "WHEN YOU ARE\nREADY.",
                      "WE CAN ALWAYS\nREST, SWAP\nCOMPANIONS, AND",
                      "SAVE HERE."
                    ],
                    "minHeight": 4,
                    "maxHeight": 4,
                    "textHeight": 3,
                    "closeButton": "a"
                  }
                }
              ],
              "false": [
                {
                  "id": "1d9eaa17-950e-50c1-b022-f2e4e4c62d9b",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "ROAM: I WILL\nKEEP THIS PORCH\nSIGNAL LIT.",
                      "ASK JUNE IN THE\nSTORE. THEN\nCHECK THE",
                      "ORCHARD LANTERN."
                    ],
                    "minHeight": 4,
                    "maxHeight": 4,
                    "textHeight": 3,
                    "closeButton": "a"
                  }
                }
              ]
            }
          }
        ]
      }
